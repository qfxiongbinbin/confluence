{
  "name": "confluence-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test packages/core/test/*.test.js packages/cli/test/*.test.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check": "npm run test && npm run smoke",
    "cli": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
